import random

# Classe que representa uma conta bancária
class Conta:
    def __init__(self, numero, titular, saldo):
        self.numero = numero
        self.titular = titular
        self.saldo = saldo

    def deposito(self, valor):
        self.saldo += valor

    def saque(self, valor):
        if valor <= self.saldo:
            self.saldo -= valor
        else:
            print(f"Conta {self.numero}: saldo insuficiente.")

# Lista de clientes fictícios
nomes = [
    "Ana", "Bruno", "Carlos", "Daniela", "Eduardo",
    "Fernanda", "Gabriel", "Helena", "Igor", "Juliana"
]

# Lista que armazenará as contas
contas = []

# Geração automática das contas
for i in range(1, 6):
    numero = 1000 + i
    titular = random.choice(nomes)
    saldo = random.randint(1000, 5000)

    conta = Conta(numero, titular, saldo)
    contas.append(conta)

# Exibe as contas criadas
print("CONTAS CRIADAS")
print("-" * 50)

for conta in contas:
    print(
        f"Conta: {conta.numero} | "
        f"Cliente: {conta.titular:<10} | "
        f"Saldo Inicial: R$ {conta.saldo:,.2f}"
    )

# Realiza movimentações aleatórias
print("\nMOVIMENTAÇÕES")
print("-" * 50)

for conta in contas:
    valor = random.randint(100, 1000)

    if random.choice([True, False]):
        conta.deposito(valor)
        operacao = "Depósito"
    else:
        conta.saque(valor)
        operacao = "Saque"

    print(
        f"Conta: {conta.numero} | "
        f"{operacao:<10} R$ {valor:>7,.2f} | "
        f"Novo Saldo: R$ {conta.saldo:>8,.2f}"
    )

# Relatório final
print("\nSALDOS FINAIS")
print("-" * 50)

for conta in contas:
    print(
        f"Conta: {conta.numero} | "
        f"Cliente: {conta.titular:<10} | "
        f"Saldo Final: R$ {conta.saldo:,.2f}"
    )


